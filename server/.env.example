# ============================================================================
# CASH COW — airdrop server (Railway)
# Copy to .env for local dev. On Railway paste these into Variables.
#
# !! Railway -> Settings -> Root Directory MUST be:  server
# ============================================================================

# --- required ---------------------------------------------------------------

# Your pump.fun mint address (the "CA").
TOKEN_MINT=YourPumpFunMintAddressHere

# The wallet you claim pump.fun creator fees INTO. Drops pay out of its balance.
TREASURY_WALLET=YourTreasuryWalletHere

# MUST be a paid RPC. A holder snapshot uses getProgramAccounts, which the
# public endpoint refuses outright — drops will fail without this.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

TOKEN_SYMBOL=COW
TOKEN_NAME=Cash Cow
TOKEN_SUPPLY=1000000000

# --- the drop ---------------------------------------------------------------

AIRDROP_INTERVAL_MS=300000     # 5 minutes. Do not go below 60000.
AIRDROP_PAYOUT_RATIO=1         # 1 = hand out the whole unreserved balance
TREASURY_RESERVE_SOL=0.05      # never spend below this (rent + tx fees)
AIRDROP_MIN_POOL_LAMPORTS=10000000   # 0.01 SOL — skip drops smaller than this
AIRDROP_MIN_TOKENS=1           # minimum holding to be in the snapshot
AIRDROP_MIN_LAMPORTS=5000      # skip allocations below this (dust)

# Wallets to leave OUT of the snapshot. The bonding curve, LP pools, your own
# team wallets — anything that is not a holder you want to pay. The treasury
# is excluded automatically. Comma separated.
EXCLUDE_WALLETS=

# --- supabase ---------------------------------------------------------------
# Optional but recommended — without it there is no record of any drop.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- sending ----------------------------------------------------------------
# OFF by default. With AUTO_PAYOUT=false the server does everything except
# send: it snapshots, allocates, and records the drop as a dry run. Read the
# payouts section of the README before turning this on — it puts a key that
# can spend the treasury on a public server.

AUTO_PAYOUT=false
# PAYOUT_SECRET_KEY=base58-secret-key-of-the-treasury-wallet

# --- server -----------------------------------------------------------------

PORT=8080
CORS_ORIGINS=*                 # lock to your Vercel domain before launch
# ADMIN_TOKEN=                 # required for POST /api/drop when set

# --- local development ------------------------------------------------------
# Invents a treasury balance and a 120-holder list so the whole cycle runs
# with no RPC key and no real token. NEVER set this on a live deployment.
# DEV_FAKE_HOLDERS=true
