# ============================================================================
# ONCHAIN BINGO — game server (Railway)
# Copy to .env for local dev. On Railway paste these into Variables.
# ============================================================================

# --- required ---------------------------------------------------------------

# Your pump.fun mint address (the "CA").
TOKEN_MINT=YourPumpFunMintAddressHere

# Wallet you claim pump.fun creator fees into. The round pot is sized from
# this wallet's balance, and it also holds the jackpot float.
TREASURY_WALLET=YourTreasuryWalletHere

# Use a real RPC. The public endpoint is rate limited and will drop lookups
# once you have more than a handful of players. Helius / QuickNode / Triton.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# --- token / eligibility ----------------------------------------------------

TOKEN_SYMBOL=BINGO
TOKEN_NAME=Bingo.fun
TOKENS_PER_CARD=1000000        # 1,000,000 $BINGO = 1 card
MIN_TOKENS_TO_PLAY=1000000     # floor to enter at all
MAX_CARDS_PER_WALLET=100       # 0 = uncapped
HOLDER_CACHE_SECONDS=30

# --- round timing (ms) ------------------------------------------------------

LOBBY_MS=30000                 # join window
PRE_ROLL_MS=3000               # "eyes down" beat before the first ball
BALL_INTERVAL_MS=2600          # casino bingo pace
CELEBRATION_MS=15000           # winner screen

# --- prizes -----------------------------------------------------------------

WIN_PATTERN=full               # full | line | x   ("full house" per the site copy)

POT_SOURCE=creator_fees        # creator_fees | fixed
POT_PAYOUT_RATIO=0.1           # pay out 10% of the unreserved float per round
TREASURY_RESERVE_SOL=0.05      # never spend below this
MIN_ROUND_POT_SOL=0.01
MAX_ROUND_POT_SOL=100
ROUND_POT_SOL=1                # only used when POT_SOURCE=fixed

PRIZE_SHARE=0.8                # 80% to the round winner
JACKPOT_SHARE=0.2              # 20% into the progressive jackpot
JACKPOT_ODDS=25                # 1-in-25 shot at the jackpot after every win

# --- supabase ---------------------------------------------------------------
# Optional but recommended — without it, history resets on every deploy.
# Use the SERVICE ROLE key here (server only, never ship it to the browser).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- payouts ----------------------------------------------------------------
# OFF by default: wins are logged to Supabase as payout_status='pending' and
# you settle them from the treasury yourself. Only flip this on once you are
# comfortable with the server holding a spending key.

AUTO_PAYOUT=false
# PAYOUT_SECRET_KEY=base58-secret-key-of-the-treasury-wallet

# --- server -----------------------------------------------------------------

PORT=8080
# Lock this to your Vercel domain before you go live.
CORS_ORIGINS=*
