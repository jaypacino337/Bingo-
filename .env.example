# ============================================================================
# Bingo.fun — frontend (Vercel)
# Copy to .env.local for local dev. In Vercel paste these into
# Settings → Environment Variables.
#
# Everything here is PUBLIC — it ships to the browser. Never put the Supabase
# service role key or a wallet secret key in this file.
# ============================================================================

# Your Railway game server. No trailing slash.
# The WebSocket URL is derived from this automatically (https -> wss).
NEXT_PUBLIC_GAME_URL=https://your-app.up.railway.app

# Your pump.fun mint address (the "CA"). Drives the BUY button link.
NEXT_PUBLIC_TOKEN_MINT=YourPumpFunMintAddressHere

NEXT_PUBLIC_TOKEN_SYMBOL=BINGO

# Must match TOKENS_PER_CARD on the server, or the marketing copy will lie.
NEXT_PUBLIC_TOKENS_PER_CARD=1000000

# Max cards one wallet can play. Must match the server's derived cap —
# 5% max holding of a 1B supply = 50,000,000 tokens = 50 cards.
NEXT_PUBLIC_MAX_CARDS=50

# The caller shown in the hall. Drop their picture at public/host.png.
NEXT_PUBLIC_CALLER_NAME=ALON
NEXT_PUBLIC_CALLER_TITLE=Founder of the hall (pump.fun)

# Optional — links are hidden when left blank.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=

# Used for OG tags / canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
