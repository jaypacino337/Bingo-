# ============================================================================
# SIDELINED — Vercel environment variables
#
# !! Root Directory must be EMPTY. Next.js is at the repo root.
# !! Redeploy after changing these — NEXT_PUBLIC_* bake in at build time.
# ============================================================================

# Your pump.fun mint address (the "CA"). Shown in the nav, drives the buy link.
NEXT_PUBLIC_TOKEN_MINT=

# Ticker shown throughout the copy.
NEXT_PUBLIC_TOKEN_SYMBOL=SIDELINED

# Socials — the links hide themselves when left blank.
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Only set this if you launch somewhere other than pump.fun.
NEXT_PUBLIC_BUY_URL=

# Used for OG tags and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
