# ============================================================================
# CASH COW — website (Vercel)
#
# !! Vercel -> Root Directory must be EMPTY (opposite of Railway)
# !! Redeploy after changing these — NEXT_PUBLIC_* bake in at build time.
# ============================================================================

# Your Railway airdrop server. https, NO trailing slash.
NEXT_PUBLIC_GAME_URL=https://your-app.up.railway.app

# Your pump.fun mint address (the "CA"). Drives the buy button.
NEXT_PUBLIC_TOKEN_MINT=YourPumpFunMintAddressHere

NEXT_PUBLIC_TOKEN_SYMBOL=COW

# Must match AIRDROP_INTERVAL_MS on the server, in minutes, or the copy lies.
NEXT_PUBLIC_DROP_MINUTES=5

NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional — links hide themselves when blank.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
